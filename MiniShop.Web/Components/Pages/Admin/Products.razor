@page "/admin/products"
@using System.Net.Http.Json
@using MiniShop.Application.DTOs
@inject NavigationManager NavigationManager

<PageTitle>Управление товарами — MiniShop</PageTitle>


<section class="create-product-panel">
    <h2>Добавить товар</h2>

    <form @onsubmit="CreateProductAsync"
          @onsubmit:preventDefault="true">


        <div class="form-field">
            <label for="productType">Тип товара</label>

            <select id="productType"
                    @bind="newProduct.ProductType">
                <option value="Physical">Физический товар</option>
                <option value="Digital">Цифровой товар</option>
            </select>
        </div>


        <div class="form-field">
            <label for="productName">Название товара</label>
            <input id="productName"
                   type="text"
                   @bind="newProduct.Name"
                   placeholder="Например, игровая мышь"
                   required />
        </div>

        <div class="form-field">
            <label for="productPrice">Цена</label>
            <input id="productPrice"
                   type="number"
                   step="0.01"
                   min="0.01"
                   @bind="newProduct.Price"
                   required />
        </div>


        @if (newProduct.ProductType == "Physical")
        {
            <div class="form-field">
                <label for="productStock">Количество на складе</label>
                <input id="productStock"
                       type="number"
                       min="0"
                       @bind="newProduct.StockQuantity"
                       required />
            </div>

            <div class="form-field">
                <label for="shippingCost">Стоимость доставки</label>
                <input id="shippingCost"
                       type="number"
                       min="0"
                       step="0.01"
                       @bind="newProduct.ShippingCost"
                       required />
            </div>
        }
        else
        {
            <div class="form-field">
                <label for="licenseDuration">Срок лицензии (дней)</label>
                <input id="licenseDuration"
                       type="number"
                       min="1"
                       @bind="newProduct.LicenseDurationDays"
                       required />
            </div>
        }


        <button type="submit"
                class="create-button"
                disabled="@isCreating">
            @(isCreating ? "Сохранение..." : "Добавить товар")
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace(createMessage))
    {
        <p class="create-message">@createMessage</p>
    }
</section>



<div class="shop-header">
    <div>
        <h1>Панель администратора</h1>
        <p>Управление товарами</p>
    </div>

    <button class="refresh-button" @onclick="LoadProductsAsync">
        Обновить каталог
    </button>
</div>

@if (isLoading)
{
    <p>Загружаем товары...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="error-message">@errorMessage</div>
}
else if (products.Count == 0)
{
    <div class="empty-state">
        <h2>Пока нет товаров</h2>
        <p>Добавленные товары появятся здесь.</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var product in products)
        {
            <article class="product-card" @key="product.Id">
                <div class="product-icon">
                    @(product.ProductType == "Physical" ? "📦" : "💻")
                </div>

                <span class="product-type">
                    @(product.ProductType == "Physical" ? "Физический товар" : "Цифровой товар")
                </span>

                <h2>@product.Name</h2>

                <p class="product-price">
                    @product.FinalPrice.ToString("N2")
                </p>

                @if (product.ProductType == "Physical")
                {
                    <p>На складе: @product.StockQuantity шт.</p>
                }
                else
                {
                    <p>Лицензия: @product.LicenseDurationDays дней</p>
                }


                @if (editingProductId == product.Id)
                {
                    <div class="edit-product-panel">
                        <h4>Редактирование товара</h4>

                        <form @onsubmit="UpdateProductAsync"
                              @onsubmit:preventDefault="true">

                            <div class="form-field">
                                <label>Название</label>
                                <input @bind="editProduct.Name" required />
                            </div>

                            <div class="form-field">
                                <label>Цена</label>
                                <input type="number"
                                       min="0.01"
                                       step="0.01"
                                       @bind="editProduct.Price"
                                       required />
                            </div>

                            @if (product.ProductType == "Physical")
                            {
                                <div class="form-field">
                                    <label>Количество на складе</label>
                                    <input type="number"
                                           min="0"
                                           @bind="editProduct.StockQuantity"
                                           required />
                                </div>

                                <div class="form-field">
                                    <label>Стоимость доставки</label>
                                    <input type="number"
                                           min="0"
                                           step="0.01"
                                           @bind="editProduct.ShippingCost"
                                           required />
                                </div>
                            }
                            else
                            {
                                <div class="form-field">
                                    <label>Срок лицензии (дней)</label>
                                    <input type="number"
                                           min="1"
                                           @bind="editProduct.LicenseDurationDays"
                                           required />
                                </div>
                            }

                            <button type="submit" disabled="@isUpdating">
                                @(isUpdating ? "Сохранение..." : "Сохранить изменения")
                            </button>

                            <button type="button" @onclick="CancelEditing">
                                Отмена
                            </button>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(editMessage))
                        {
                            <p class="error-message">@editMessage</p>
                        }
                    </div>
                }


                <button type="button"
                        class="edit-button"
                        @onclick="() => StartEditing(product)">
                    Редактировать
                </button>


                <button class="delete-button"
                        @onclick="() => DeleteProductAsync(product.Id)">
                    Удалить
                </button>
            </article>
        }
    </div>
}

@code {



    private CreateProductModel newProduct = new();
    private bool isCreating;
    private string? createMessage;


    private sealed class CreateProductModel
    {
        public string Name { get; set; } = string.Empty;

        public decimal Price { get; set; } = 1;

        public string ProductType { get; set; } = "Physical";

        public int StockQuantity { get; set; } = 0;

        public decimal ShippingCost { get; set; } = 200m;

        public int LicenseDurationDays { get; set; } = 365;
    }


    private List<ProductDto> products = new();
    private bool isLoading = true;
    private string? errorMessage;


    private int? editingProductId;
    private EditProductModel editProduct = new();
    private bool isUpdating;
    private string? editMessage;

    private sealed class EditProductModel
    {
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; } = 1;
        public int StockQuantity { get; set; }
        public decimal ShippingCost { get; set; }
        public int LicenseDurationDays { get; set; } = 365;
    }


    private HttpClient CreateApiClient()
    {
        return new HttpClient
        {
            BaseAddress = new Uri(NavigationManager.BaseUri)
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }


    private void StartEditing(ProductDto product)
    {
        editingProductId = product.Id;
        editMessage = null;

        editProduct = new EditProductModel
        {
            Name = product.Name,
            Price = product.Price,
            StockQuantity = product.StockQuantity,
            ShippingCost = product.ShippingCost,
            LicenseDurationDays = product.LicenseDurationDays
        };
    }

    private void CancelEditing()
    {
        editingProductId = null;
        editMessage = null;
    }

    private async Task UpdateProductAsync()
    {
        if (editingProductId is null)
            return;

        if (string.IsNullOrWhiteSpace(editProduct.Name))
        {
            editMessage = "Введите название товара.";
            return;
        }

        if (editProduct.Price <= 0)
        {
            editMessage = "Цена должна быть больше нуля.";
            return;
        }

        isUpdating = true;
        editMessage = null;

        try
        {
            using var client = CreateApiClient();

            var request = new
            {
                editProduct.Name,
                editProduct.Price,
                editProduct.StockQuantity,
                editProduct.ShippingCost,
                editProduct.LicenseDurationDays
            };

            var response = await client.PutAsJsonAsync($"api/products/{editingProductId}", request);

            if (!response.IsSuccessStatusCode)
            {
                var responseBody = await response.Content.ReadAsStringAsync();

                editMessage = $"Ошибка API ({(int)response.StatusCode}): {responseBody}";

                return;
            }

            editingProductId = null;
            editMessage = null;

            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            editMessage = $"Ошибка подключения к API: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }


    private async Task LoadProductsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            using var client = CreateApiClient();

            var result = await client.GetFromJsonAsync<List<ProductDto>>(
                "api/products");

            products = result ?? new List<ProductDto>();
        }
        catch (Exception)
        {
            errorMessage =
                "Не удалось загрузить каталог. Проверь, запущен ли API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteProductAsync(int id)
    {
        try
        {
            using var client = CreateApiClient();

            var response = await client.DeleteAsync($"api/products/{id}");

            if (response.IsSuccessStatusCode)
            {

                products.RemoveAll(product => product.Id == id);
            }
            else
            {
                errorMessage = "Не удалось удалить товар.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ошибка подключения к API.";
        }
    }


    private async Task CreateProductAsync()
    {
        createMessage = null;
        errorMessage = null;
        isCreating = true;

        try
        {
            using var client = CreateApiClient();


            var request = new
            {
                newProduct.Name,
                newProduct.Price,
                newProduct.ProductType,
                StockQuantity = newProduct.ProductType == "Physical" ? newProduct.StockQuantity : 0,
                ShippingCost = newProduct.ProductType == "Physical" ? newProduct.ShippingCost : 0m,
                LicenseDurationDays = newProduct.ProductType == "Digital" ? newProduct.LicenseDurationDays : 0
            };

            var response = await client.PostAsJsonAsync(
                "api/products",
                request);


            var responseBody =
                await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                createMessage =
                    $"Ошибка API ({(int)response.StatusCode}): {responseBody}";
                return;
            }

            createMessage = "Товар успешно добавлен.";

            newProduct = new CreateProductModel();

            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            createMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

}
