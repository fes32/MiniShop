@page "/shopping-cart"
@using MiniShop.Web.Models
@using MiniShop.Web.Services
@implements IDisposable
@inject CartService Cart
@using System.Net.Http.Json
@using MiniShop.Application.DTOs
@inject CartService Cart
@inject NavigationManager NavigationManager

<PageTitle>Корзина — MiniShop</PageTitle>

<h1>Корзина</h1>

@if (Cart.Items.Count == 0)
{
    <div class="empty-state">
        <h2>Корзина пуста</h2>
        <p>Добавь товары из каталога, чтобы продолжить.</p>
        <a href="/">Перейти в каталог</a>
    </div>
}
else
{
    <div class="cart-list">
        @foreach (var item in Cart.Items)
        {
            <article class="product-card" @key="item.Product.Id">
                <h2>@item.Product.Name</h2>

                <p>
                    Цена за единицу:
                    @item.Product.FinalPrice.ToString("N2")
                </p>

                <div class="form-field">
                    <label for="@($"quantity-{item.Product.Id}")">
                        Количество
                    </label>

                    <input id="@($"quantity-{item.Product.Id}")"
                           type="number"
                           min="1"
                           max="@(item.Product.ProductType == "Physical"? item.Product.StockQuantity: null)"
                   value="@item.Quantity"
                   @onchange="e => ChangeQuantity(item.Product.Id, e.Value?.ToString())" />
        </div>

        <p>
            Стоимость:
            <strong>@item.TotalPrice.ToString("N2")</strong>
        </p>

        <button type="button"
                class="delete-button"
                @onclick="() => Cart.Remove(item.Product.Id)">
            Убрать из корзины
        </button>
    </article>
        }
    </div>

    <section class="create-product-panel">
        <h2>Итого: @Cart.TotalPrice.ToString("N2")</h2>
        <p>Количество товаров: @Cart.TotalItems</p>

        <button class="btn btn-primary"
                @onclick="BuyAsync"
                disabled="@isPurchasing">
            @(isPurchasing ? "Покупка..." : "Купить")
        </button>



        <button type="button"
                class="refresh-button"
                @onclick="Cart.Clear">
            Очистить корзину
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3" role="alert">
            @message
        </div>
    }
}

@code {
    private string? message;
    private bool isPurchasing = false;
    private bool isError = false;

    protected override void OnInitialized()
    {
        Cart.OnChange += HandleCartChanged;
    }

    private void HandleCartChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ChangeQuantity(int productId, string? value)
    {
        if (int.TryParse(value, out var quantity))
        {
            try
            {
                Cart.ChangeQuantity(productId, quantity);
            }
            catch (InvalidOperationException ex)
            {
                message = ex.Message;
            }
        }
    }

    private async Task BuyAsync()
    {
        if (isPurchasing)
            return;

        if (Cart.Items.Count == 0)
        {
            message = "Корзина пуста. Добавьте товары перед покупкой.";
            isError = true;
            return;
        }

        isPurchasing = true;
        message = string.Empty;
        isError = false;

        try
        {
            var client = new HttpClient
            {
                BaseAddress = new Uri(NavigationManager.BaseUri)
            };

            var request = new PurchaseRequest
            {
                Items = Cart.Items.Select(item => new PurchaseItemDto
                {
                    ProductId = item.Product.Id,
                    Quantity = item.Quantity
                }).ToList()
            };

            var response = await client.PostAsJsonAsync("api/products/purchase",request);

            if (response.IsSuccessStatusCode)
            {
                Cart.Clear();
                message = "Покупка успешно выполнена!";
                isError = false;


            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Ошибка покупки: {error}";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            message = $"Не удалось выполнить покупку: {ex.Message}";
        }
        finally
        {
            isPurchasing = false;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= HandleCartChanged;
    }
}
