<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\MiniShop.Application\MiniShop.Application.csproj" />
		<ProjectReference Include="..\MiniShop.Api\MiniShop.Api.csproj" />
	</ItemGroup>

	<Target Name="RemoveApiAppSettingsFromPublish" BeforeTargets="ComputeFilesToPublish">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('\MiniShop.Api\appsettings.json')) Or $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('\MiniShop.Api\appsettings.Development.json'))" />
		</ItemGroup>
	</Target>
</Project>
